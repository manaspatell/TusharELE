<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Admin Panel - Tushar Electronics</title>
    <link rel="icon" type="image/png" href="/logo/Logo1.png?v=3">
    <link rel="apple-touch-icon" href="/logo/Logo1.png?v=3">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="<%= baseUrl %>/dashboard">
                <img src="/logo/Logo.png" alt="Tushar Electronics" height="30" class="me-2" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                <span style="display:none;"><i class="bi bi-gear"></i> Tushar Electronics Admin</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="<%= baseUrl %>/dashboard">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= baseUrl %>/products">
                            <i class="bi bi-box"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= baseUrl %>/categories">
                            <i class="bi bi-tags"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= baseUrl %>/inquiries">
                            <i class="bi bi-envelope"></i> Inquiries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= baseUrl %>/articles">
                            <i class="bi bi-file-text"></i> Articles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= baseUrl %>/banners">
                            <i class="bi bi-image"></i> Banners
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/" target="_blank">
                            <i class="bi bi-globe"></i> View Site
                        </a>
                    </li>
                    <li class="nav-item">
                                                <% if (typeof admin2faEnabled !== 'undefined' && admin2faEnabled) { %>
                                                <div class="nav-item dropdown">
                                                    <a class="nav-link dropdown-toggle" href="#" id="twoFaMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-lock-fill text-success"></i> 2FA
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="twoFaMenu">
                                                        <li><a class="dropdown-item" href="<%= baseUrl %>/2fa/setup">Manage 2FA</a></li>
                                                        <li><form action="<%= baseUrl %>/2fa/disable" method="post" class="px-3"><button class="btn btn-link p-0">Disable 2FA</button></form></li>
                                                    </ul>
                                                </div>
                                                <% } else { %>
                                                <div class="nav-item dropdown">
                                                    <a class="nav-link dropdown-toggle" href="#" id="twoFaMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-lock"></i> 2FA
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="twoFaMenu">
                                                        <li><a class="dropdown-item" href="<%= baseUrl %>/2fa/setup">Enable 2FA</a></li>
                                                    </ul>
                                                </div>
                                                <% } %>
                                                <a class="nav-link" href="<%= baseUrl %>/logout">
                                                        <i class="bi bi-box-arrow-right"></i> Logout
                                                </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


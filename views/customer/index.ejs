<%- include('partials/header', {
    title: 'Home',
    isHome: true,
    metaDescription: 'Tushar Electronics - Custom insect trap manufacturing, sustainable agriculture solutions, and bulk orders. Shop categories, products, and read our blog.',
    metaKeywords: 'insect traps, agriculture, bulk manufacturing, categories, products, blog',
    canonical: 'https://tusharagro.com/'
}) %>
<!-- JSON-LD: Homepage -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Tushar Electronics",
    "url": "https://tusharagro.com/",
    "description": "Tushar Electronics - Custom insect trap manufacturing, sustainable agriculture solutions, and bulk orders.",
    "potentialAction": {
        "@type": "SearchAction",
        "target": "https://tusharagro.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
    }
}

// Randomized, on-scroll animations for homepage cards (featured products + categories)
document.addEventListener('DOMContentLoaded', function(){
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const selectors = [
        '.home-sections .featured-products-wrapper > .product-card',
        '.category-slider > .card.category-card',
        '.article-slider .article-card',
        '.testimonials-section .testimonial-card',
        '.why-choose-section .feature-box',
        '.trust-badges-wrapper .trust-badge'
    ];
    const cards = document.querySelectorAll(selectors.join(','));
    if (!cards.length) return;

    const variants = ['left','right','up','down','zoom','tilt'];
    const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const el = entry.target;
                // preflight will-change shortly before anim to avoid long-lived cost
                el.style.willChange = 'transform, opacity';
                const idx = Number(el.dataset.seq) || 0;
                const delaySec = ( (idx % 8) * 0.06 + Math.random() * 0.08 );
                el.style.animationDelay = delaySec.toFixed(2) + 's';
                el.classList.add('in');
                el.addEventListener('animationend', () => { el.style.willChange = 'auto'; }, { once: true });
                obs.unobserve(el);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });

    cards.forEach((el, i) => {
        const variant = variants[Math.floor(Math.random() * variants.length)];
        el.classList.add('pp-anim');
        el.dataset.anim = variant;
        el.dataset.seq = i;
        io.observe(el);
    });
});
</script>


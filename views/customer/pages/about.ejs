<script>
// Lightweight scroll animation (no external lib)
document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('in-view');
                observer.unobserve(e.target);
            }
        });
    }, { threshold: 0.18 });
    document.querySelectorAll('.fade-section, .slide-up, .fade-left, .scale-in').forEach(el => observer.observe(el));
});
</script>


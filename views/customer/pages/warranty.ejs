<%- include('../partials/header', { title: 'Warranty Policy' }) %>

<div class="container py-5">
  <div class="text-center mb-5 fade-in-up">
    <div class="icon-badge primary mb-3"><i class="bi bi-shield-check"></i></div>
    <h1 class="display-6 fw-semibold">Warranty Policy</h1>
    <p class="lead text-muted mb-0">Coverage details, claim process, and support information.</p>
  </div>

  <div class="row g-4 align-items-stretch">
    <div class="col-12 fade-in-up" style="animation-delay:.05s;">
      <div class="h-100 shadow-sm premium-card glass">
        <div class="card-inner">
          <div class="mb-4">
            <div class="icon-badge accent mb-2"><i class="bi bi-info-circle"></i></div>
            <h2 class="h5 fw-semibold mb-2">Standard Coverage</h2>
            <ul class="text-muted small">
              <li>Manufacturer warranty applies as mentioned on the product page or invoice.</li>
              <li>Warranty covers manufacturing defects only; damage due to misuse or unauthorized repair is excluded.</li>
              <li>Warranty period starts from the date of purchase.</li>
            </ul>
          </div>

          <div class="mb-4 slide-in-field" style="animation-delay:.1s;">
            <div class="icon-badge primary mb-2"><i class="bi bi-clipboard-check"></i></div>
            <h3 class="h6 fw-semibold mb-2">How to Claim</h3>
            <ol class="text-muted small">
              <li>Keep your invoice ready for verification.</li>
              <li>Contact support at <a href="tel:+919171310766">+91 9171310766</a> or <a href="mailto:tusharelectronics8439@gmail.com">tusharelectronics8439@gmail.com</a>.</li>
              <li>Describe the issue clearly and share photos/videos if needed.</li>
              <li>We coordinate with the authorized service center or manufacturer.</li>
            </ol>
          </div>

          <div class="mb-4 slide-in-field" style="animation-delay:.15s;">
            <div class="icon-badge primary mb-2"><i class="bi bi-x-circle"></i></div>
            <h3 class="h6 fw-semibold mb-2">Exclusions</h3>
            <ul class="text-muted small">
              <li>Physical damage, water damage, or improper installation.</li>
              <li>Consumables and accessories unless specified by the manufacturer.</li>
              <li>Normal wear and tear or cosmetic issues.</li>
            </ul>
          </div>

          <div class="mb-2 slide-in-field" style="animation-delay:.2s;">
            <div class="icon-badge primary mb-2"><i class="bi bi-clock-history"></i></div>
            <h3 class="h6 fw-semibold mb-2">Turnaround</h3>
            <p class="text-muted small mb-0">Resolution time depends on service center queue and parts availability. We aim to assist promptly.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 text-center">
    <a class="btn btn-outline-primary" href="/return-refund-policy">View Returns & Refunds</a>
    <a class="btn btn-primary ms-2" href="/contact">Contact Support</a>
  </div>
</div>

<%- include('../partials/footer') %>

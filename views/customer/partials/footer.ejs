<!-- ===== Redesigned Footer (semantic & responsive) ===== -->
<footer class="site-footer premium-footer footer-modern" role="contentinfo" aria-label="Site footer">
  <!-- Three.js footer background canvas -->
  <div id="footer-bg" aria-hidden="true" style="position:absolute; inset:0; z-index:0; pointer-events:none;"></div>
  <div class="premium-footer-inner">
    <div class="footer-grid footer-top">
      <!-- Column 1: About -->
      <div class="footer-col footer-about">
        <a class="brand" href="/" aria-label="Tushar Electronics homepage">Tushar Electronics</a>
        <p class="muted">Trusted electronics retailer with local support, warranty & dedicated customer care.</p>
        <address class="footer-address">
          <strong>Address</strong><br />
          Based in Indore, Madhya Pradesh<br />
          <a href="tel:+919171310766" class="footer-link" aria-label="Call customer care">+91 9171310766</a><br />
          <a href="mailto:tusharelectronics8439@gmail.com" class="footer-link">tusharelectronics8439@gmail.com</a>
        </address>
      </div>

      <!-- Column 2: Shop -->
      <nav class="footer-col footer-shop" aria-label="Shop links">
        <h4 class="footer-heading">Shop</h4>
        <ul class="footer-list">
          <li><a class="footer-link" href="/products">All Products</a></li>
          <li><a class="footer-link" href="/products?filter=bestsellers">Best Sellers</a></li>
          <li><a class="footer-link" href="/products?filter=featured">Featured</a></li>
          <li><a class="footer-link" href="/products?filter=new">New Arrivals</a></li>
        </ul>
      </nav>

      <!-- Column 3: Customer Support -->
      <div class="footer-col footer-support" aria-label="Customer support">
        <h4 class="footer-heading">Customer Support</h4>
        <ul class="footer-list">
          <li><a class="footer-link" href="/contact">Contact Us</a></li>
          <li><a class="footer-link" href="/faq">FAQ</a></li>
          <li><a class="footer-link" href="/return-refund-policy">Returns & Refunds</a></li>
          <li><a class="footer-link" href="/shipping-policy">Shipping Info</a></li>
          <li><a class="footer-link" href="/privacy">Privacy Policy</a></li>
          <li><a class="footer-link" href="/terms">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Column 4: Legal -->
      <div class="footer-col footer-legal" aria-label="Legal links">
        <h4 class="footer-heading">Legal</h4>
        <ul class="footer-list">
          <li><a class="footer-link" href="/privacy-policy">Privacy Policy</a></li>
          <li><a class="footer-link" href="/terms-conditions">Terms & Conditions</a></li>
          <li><a class="footer-link" href="/warranty">Warranty</a></li>
          <li><a class="footer-link" href="/return-refund-policy">Returns & Refunds</a></li>
        </ul>
      </div>

      <!-- Column 5: Newsletter + Social -->
      <div class="footer-col footer-newsletter" aria-label="Newsletter signup">
        <h4 class="footer-heading">Newsletter</h4>
        <p class="muted small">Get monthly deals, new arrivals & tips — no spam.</p>

        <form id="footerNewsletterForm" class="footer-newsletter-form" action="/newsletter" method="POST" novalidate>
          <label for="footerEmail" class="visually-hidden">Email address</label>
          <div class="newsletter-row">
            <input id="footerEmail" name="email" type="email" placeholder="you@example.com" required class="newsletter-input" />
            <button type="submit" class="btn newsletter-btn" aria-label="Subscribe to newsletter">Subscribe</button>
          </div>
        </form>
        <div id="newsletterSuccess" style="display:none; color:green; margin-top:8px; font-weight:500;">Successfully subscribed to newsletter!</div>
        <script>
          document.getElementById('footerNewsletterForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const form = e.target;
            const email = form.email.value;
            const btn = form.querySelector('button');
            btn.disabled = true;
            try {
              const res = await fetch('/newsletter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
              });
              const data = await res.json();
              if (data.success) {
                document.getElementById('newsletterSuccess').style.display = 'block';
                form.reset();
              } else {
                alert(data.message || 'Subscription failed.');
              }
            } catch {
              alert('Network error. Please try again.');
            }
            btn.disabled = false;
          });
        </script>

        <div class="footer-social" aria-hidden="false">
          <a class="social-link" href="#" aria-label="Facebook - Tushar Electronics"><i class="bi bi-facebook"></i></a>
          <a class="social-link" href="#" aria-label="Instagram - Tushar Electronics"><i class="bi bi-instagram"></i></a>
          <a class="social-link" href="#" aria-label="YouTube - Tushar Electronics"><i class="bi bi-youtube"></i></a>
          <a class="social-link" href="#" aria-label="Twitter - Tushar Electronics"><i class="bi bi-twitter"></i></a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="footer-divider" role="presentation" aria-hidden="true"></div>

    <!-- Bottom: Badges and copyright -->
    <div class="footer-bottom">
      <div class="badges" aria-hidden="false">
        <div class="badge badge-icon badge-secure" role="img" aria-label="Secure Checkout" title="Secure Checkout">
          <i class="bi bi-shield-check" aria-hidden="true"></i>
        </div>
        <div class="badge badge-icon badge-visa" role="img" aria-label="Credit card payments accepted" title="Cards accepted">
          <i class="bi bi-credit-card" aria-hidden="true"></i>
        </div>
        <div class="badge badge-icon badge-merchant" role="img" aria-label="Trusted merchant" title="Trusted merchant">
          <i class="bi bi-award" aria-hidden="true"></i>
        </div>
        <div class="badge badge-icon badge-razorpay" role="img" aria-label="UPI and Netbanking" title="UPI and Netbanking">
          <i class="bi bi-bank" aria-hidden="true"></i>
        </div>
      </div>

      <div class="copyright muted small">
        &copy; <%= new Date().getFullYear() %> Tushar Electronics. All rights reserved. Designed with care.
      </div>
    </div>
  </div>
  <!-- Cookie Consent Banner -->
  <div id="cookieConsent" style="display:none; position:fixed; bottom:0; left:0; right:0; background:#222; color:#fff; padding:16px; z-index:9999; text-align:center; font-size:1rem;">
    This website uses cookies to ensure you get the best experience. 
    <a href="/privacy" style="color:#ffd700; text-decoration:underline;">Learn more</a>.
    <button id="acceptCookies" style="margin-left:16px; background:#ffd700; color:#222; border:none; padding:6px 16px; border-radius:4px; cursor:pointer;">Accept</button>
  </div>
  <script>
    // Simple cookie consent logic
    if (!localStorage.getItem('cookieConsent')) {
      document.getElementById('cookieConsent').style.display = 'block';
      document.getElementById('acceptCookies').onclick = function() {
        localStorage.setItem('cookieConsent', 'true');
        document.getElementById('cookieConsent').style.display = 'none';
      };
    }
  </script>
</footer>

<!-- Customer Care Floating Widget (preserved) -->
<style>
.customer-care-widget { position: fixed; right: 18px; bottom: 18px; z-index: 1080; display: flex; align-items: center; gap: 10px; transform: translateY(0); transition: transform 0.28s ease, opacity 0.28s ease; opacity: 1; pointer-events: auto; will-change: transform, opacity; }
.customer-care-widget.show { opacity: 1; transform: translateY(0); }
.customer-care-widget .cc-link { display: flex; align-items: center; gap: 10px; background: linear-gradient(135deg, #0ea5a4 0%, #06b6d4 100%); color: #fff; padding: 12px 14px; border-radius: 999px; box-shadow: 0 12px 34px rgba(3,105,120,0.32); text-decoration: none; min-width: 170px; align-self: flex-end; transform-origin: center; border: 2px solid rgba(255,255,255,0.85); }
.customer-care-widget .cc-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.22); flex: 0 0 44px; font-size: 1.15rem; position: relative; overflow: visible; }
.customer-care-widget .cc-text { line-height: 1; display:flex;flex-direction:column; }
.customer-care-widget .cc-text strong { font-size: 13px; font-weight:700; display:block; }
.customer-care-widget .cc-text small { font-size: 11px; opacity:0.95; }
@keyframes cc-float { 0% { transform: translateY(0); } 50% { transform: translateY(-6px); } 100% { transform: translateY(0); } }
.customer-care-widget .cc-link { animation: cc-float 3.8s ease-in-out infinite; }
.customer-care-widget .cc-icon::after { content: ""; position: absolute; width: 44px; height: 44px; border-radius: 50%; left: 0; top: 0; transform: translate(-2px, -2px); box-shadow: 0 0 0 0 rgba(14,165,164,0.25); animation: cc-pulse 2.6s infinite; pointer-events: none; }
@keyframes cc-pulse { 0% { box-shadow: 0 0 0 0 rgba(14,165,164,0.30); } 70% { box-shadow: 0 0 0 12px rgba(14,165,164,0); } 100% { box-shadow: 0 0 0 0 rgba(14,165,164,0); } }
@media (max-width: 420px) { .customer-care-widget { right: 12px; bottom: 12px; } .customer-care-widget .cc-link { min-width: 140px; padding: 10px 12px; } .customer-care-widget .cc-icon { width: 38px; height: 38px; flex: 0 0 38px; } }
</style>

<div id="customerCareWidget" class="customer-care-widget" aria-hidden="true">
    <a id="customerCareLink" class="cc-link" href="tel:+919171310766" aria-label="Call Customer Care">
        <span class="cc-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><defs><radialGradient id="g1" cx="30%" cy="20%" r="100%"><stop offset="0%" stop-color="#26a0da" /><stop offset="100%" stop-color="#0b84d8" /></radialGradient></defs><circle cx="24" cy="24" r="22" fill="url(#g1)" /><circle cx="24" cy="24" r="21" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="2" /><circle cx="24" cy="18" r="5.2" fill="#fff" opacity="0.95" /><path d="M20.2 17.2c0-1.9 1.8-3.5 3.8-3.5s3.8 1.6 3.8 3.5c0 .6-.3 1.1-.7 1.5-.6.7-2.9 1-3.1.9-.2-.2-2.6-.3-3.8-.9-.5-.2-.9-.7-.9-1.5z" fill="#0b84d8" opacity="0.98" /><path d="M16 27c0-3.2 3.6-5.2 8-5.2s8 2 8 5.2v1.8c0 .8-.6 1.4-1.4 1.4h-2.6c-.5 0-.9-.4-.9-.9v-3.0c0-.5-.4-1-1-1h-6c-.6 0-1 .5-1 1v3.0c0 .5-.4.9-.9.9H17.4C16.6 30.2 16 29.6 16 28.8V27z" fill="#fff" opacity="0.95" /><path d="M9.5 22.5c0-7.4 6.6-13.4 14.5-13.4S38.5 15.1 38.5 22.5v1.2c0 .8-.6 1.4-1.4 1.4h-1.4c-.5 0-.9-.4-.9-.9v-2.2c0-.7-.6-1.3-1.3-1.3h-3.2c-.7 0-1.3.6-1.3 1.3v2.2c0 .5-.4.9-.9.9h-2.6c-.5 0-.9-.4-.9-.9v-2.2c0-.7-.6-1.3-1.3-1.3h-3.2c-.7 0-1.3.6-1.3 1.3v2.2c0 .5-.4.9-.9.9H10.9c-.8 0-1.4-.6-1.4-1.4v-1.2z" fill="#fff" opacity="0.95" /></svg>
        </span>
        <span class="cc-text"><strong>Customer Care</strong><small>Tap to call</small></span>
    </a>
</div>

<script>
(function(){
    function initCustomerCare() {
        try {
            var widget = document.getElementById('customerCareWidget');
            var link = document.getElementById('customerCareLink');
            if (!widget || !link) return;
            var footerPhone = document.querySelector('.footer-address a[href^="tel:"]');
            if (footerPhone && footerPhone.getAttribute('href')) { link.setAttribute('href', footerPhone.getAttribute('href')); }
            // Ensure visible by default
            widget.style.opacity = '1';
            setTimeout(function(){ widget.classList.add('show'); widget.setAttribute('aria-hidden','false'); }, 550);
            // Only soften visibility near bottom, do not hide completely
            var hideOnFooter = function(){
              try {
                var scrolledFromBottom = (document.documentElement.scrollHeight - window.scrollY - window.innerHeight);
                if (scrolledFromBottom < 80) {
                  widget.style.opacity = '0.6';
                } else {
                  widget.style.opacity = '1';
                }
              } catch(e){}
            };
            window.addEventListener('scroll', hideOnFooter, { passive: true }); hideOnFooter();
            link.addEventListener('click', function(){ try { link.style.transform = 'scale(0.98)'; setTimeout(function(){ link.style.transform = ''; }, 160); } catch(e){} });
        } catch (err) { console.error('Customer care widget init failed', err); }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCustomerCare); else initCustomerCare();
})();
</script>


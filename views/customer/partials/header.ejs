    <script src="/js/navbar-three.js"></script>
    <script src="/js/welcome-three.js"></script>

    <script>
    // Toggle background blur and search container highlight on focus
    document.addEventListener('DOMContentLoaded', function(){
        const desktopInput = document.getElementById('searchInput');
        const mobileInput = document.getElementById('searchInputMobile');
        const toggle = (active) => document.body.classList.toggle('search-active', active);
        [desktopInput, mobileInput].forEach(inp => {
            if (!inp) return;
            inp.addEventListener('focus', () => toggle(true));
            inp.addEventListener('blur', () => toggle(false));
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
    });
    </script>


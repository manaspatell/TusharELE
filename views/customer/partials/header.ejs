<body<% if (typeof isHome !== 'undefined' && isHome) { %> class="home-page"<% } %>>
    <!-- Premium Loader Overlay -->
    <div id="preloader" class="preloader" aria-hidden="false" aria-label="Loading Tushar Electronics">
        <div class="preloader-inner">
            <div class="canvas-glow">
                <canvas id="loaderCanvas" class="loader-canvas" aria-hidden="true"></canvas>
                <div class="glow-ring" aria-hidden="true"></div>
            </div>
            <h1 class="typewriter" aria-live="polite">
                <span class="tw-prefix">Welcome to</span>
                <span class="tw-brand">Tushar Electronics</span>
                <span class="tw-caret" aria-hidden="true">|</span>
            </h1>
            <div class="progress-wrap" aria-label="Loading Progress">
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill" style="width:0%"></div>
                </div>
                <div class="progress-text" id="progressText">0%</div>
            </div>
        </div>
    </div>
    <!-- Audio removed as requested -->
    <!-- Welcome Banner (Home page only) -->
    <% if (typeof isHome !== 'undefined' && isHome) { %>
    <div class="welcome-banner py-3 text-center position-relative overflow-hidden">

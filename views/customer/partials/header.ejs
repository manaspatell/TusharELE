        <div class="welcome-banner-pattern"></div>
        <div class="container position-relative">
            <div class="row align-items-center">
                <div class="col-md-12">
                    <div class="welcome-content">
                        <h4 class="mb-0 welcome-title">
                            Welcome to <span class="brand-highlight">Tushar Electronics</span>
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Top Bar (Home page only) -->
